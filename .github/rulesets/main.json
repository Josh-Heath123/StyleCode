{
  "name": "main: merges you can trust",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_signatures" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Quick checks", "integration_id": 15368 },
          { "context": "Unit tests", "integration_id": 15368 },
          { "context": "Build", "integration_id": 15368 },
          { "context": "Browser tests", "integration_id": 15368 },
          { "context": "Type-check, test and build (Windows)", "integration_id": 15368 },
          { "context": "Dependency review", "integration_id": 15368 },
          { "context": "New runtime dependencies", "integration_id": 15368 }
        ]
      }
    }
  ]
}
