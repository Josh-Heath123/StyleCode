exports[`generated code is pinned > for a landing page > html 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Landing page</title>
    <link rel="stylesheet" href="base.css">
    <link rel="stylesheet" href="landing-page.css">
  </head>
  <body>
    <div class="landing-page">
      <h1 class="headline">Research notes that &lt;organise&gt; themselves</h1>
      <img class="product-shot" src="assets/asset_aaaaaaaaaaaa.jpg" alt="Product shot">
      <div class="features">
        <article class="feature-card">
          <div class="icon"></div>
          <h2 class="title">Tag as you go</h2>
          <p class="body">Notes stay linked to their source.</p>
        </article>
        <article class="feature-card-2">
          <div class="icon-2"></div>
          <h2 class="title-2">Shared by default</h2>
          <p class="body-2">Notes stay linked to their source.</p>
        </article>
        <article class="feature-card-3">
          <div class="icon-3"></div>
          <h2 class="title-3">Answers, not "folders"</h2>
          <p class="body-3">Notes stay linked to their source.</p>
        </article>
      </div>
      <div class="sketch">
        <div class="blob"></div>
      </div>
      <nav class="navigation">
        <p class="logo">Brand</p>
        <ul class="links">
          <li class="display-contents">
            <a class="product" href="#">Product</a>
          </li>
          <li class="display-contents">
            <a class="pricing" href="#">Pricing</a>
          </li>
          <li class="display-contents">
            <a class="about" href="#">About</a>
          </li>
        </ul>
        <button class="sign-up-button" type="button">
          <span class="sign-up">Sign up</span>
        </button>
      </nav>
      <div class="text-field">
        <span class="label">Email</span>
        <input class="input" type="text" placeholder="you@example.com">
      </div>
    </div>
  </body>
</html>
"
`;

