  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  white-space: pre;
}

.input {
  padding: 10px 12px;
  flex: none;
  align-self: stretch;
  height: 43px;
  background: #ffffff;
  border: 1px solid #e1e4ea;
  border-radius: 8px;
  color: #5b6474;
  font-family: Inter, system-ui, sans-serif;
