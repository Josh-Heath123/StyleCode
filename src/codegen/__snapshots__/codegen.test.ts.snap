exports[`generated code is pinned > for a landing page > tsx 1`] = `
"import type { CSSProperties } from 'react';
import s from './LandingPage.module.css';
import image1 from '../assets/asset_aaaaaaaaaaaa.jpg';

interface FeatureCardProps {
  iconBackground: string;
  title: string;
}

function FeatureCard({ iconBackground, title }: FeatureCardProps) {
  return (
    <article className={s.featureCard}>
      <div className={s.icon} style={{ '--icon-background': iconBackground } as CSSProperties} />
      <h2 className={s.title}>{title}</h2>
      <p className={s.body}>Notes stay linked to their source.</p>
    </article>
  );
}

export default function LandingPage() {
  return (
    <div className={s.landingPage}>
      <h1 className={s.headline}>{"Research notes that <organise> themselves"}</h1>
      <img className={s.productShot} src={image1} alt="Product shot" />
      <div className={s.features}>
        <FeatureCard iconBackground="#2f7bff" title="Tag as you go" />
        <FeatureCard iconBackground="#ff9f5a" title="Shared by default" />
        <FeatureCard iconBackground="#34c77b" title={"Answers, not \\"folders\\""} />
      </div>
      <div className={s.sketch}>
        <div className={s.blob} />
      </div>
      <nav className={s.navigation}>
        <p className={s.logo}>Brand</p>
        <ul className={s.links}>
          <li className="display-contents">
            <a className={s.product} href="#">Product</a>
          </li>
          <li className="display-contents">
            <a className={s.pricing} href="#">Pricing</a>
          </li>
          <li className="display-contents">
            <a className={s.about} href="#">About</a>
          </li>
        </ul>
        <button className={s.signUpButton} type="button">
          <span className={s.signUp}>Sign up</span>
        </button>
      </nav>
      <div className={s.textField}>
        <span className={s.label}>Email</span>
        <input className={s.input} type="text" placeholder="you@example.com" />
      </div>
    </div>
  );
}
"
`;
