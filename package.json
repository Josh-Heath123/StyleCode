{
  "name": "stylecode",
  "version": "0.5.0",
  "private": true,
  "description": "A local-first visual UI editor where the canvas is the prompt: draw interfaces, collaborate with an AI through structured edits, and export real frontend code.",
  "license": "MIT",
  "homepage": "https://josh-heath123.github.io/StyleCode/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josh-Heath123/StyleCode.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "demos": "playwright test -c e2e/demos/demos.config.ts",
    "site": "node --experimental-strip-types scripts/build-site.ts",
    "build:pages": "vite build --base=/StyleCode/app/ --outDir site/app --emptyOutDir && npm run site"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
